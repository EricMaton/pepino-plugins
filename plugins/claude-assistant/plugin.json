{
  "id": "dev.pepino.claude-assistant",
  "name": "Claude Assistant",
  "version": "0.2.0",
  "apiVersion": "1",
  "description": "Chat with Claude about the open project, with your own account: sign in with OpenRouter, or use your Anthropic API key. It reads your files to answer; it never changes them on its own.",
  "permissions": [
    "network",
    "fs.read",
    "editor.read"
  ],
  "networkJustification": "It sends your messages, and the files it reads to answer them, to Claude through your own account: OpenRouter (openrouter.ai) or Anthropic's API (api.anthropic.com).",
  "secrets": [
    {
      "key": "openrouter",
      "label": "OpenRouter account",
      "host": "openrouter.ai",
      "header": "authorization",
      "prefix": "Bearer ",
      "signIn": "openrouter"
    },
    {
      "key": "anthropic",
      "label": "Anthropic API key",
      "host": "api.anthropic.com",
      "header": "x-api-key",
      "help": "https://console.anthropic.com/settings/keys"
    }
  ],
  "contributes": {
    "pages": [
      {
        "id": "chat",
        "title": "Claude",
        "file": "chat.html"
      }
    ],
    "settings": [
      {
        "key": "model",
        "type": "string",
        "default": "claude-opus-5-5",
        "title": "Model"
      },
      {
        "key": "maxTokens",
        "type": "number",
        "default": 8192,
        "title": "Longest answer (tokens)"
      }
    ]
  }
}
